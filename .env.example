# Environment file for gajae-way Docker Compose setup
# Copy this to .env.gajaeway and fill in your credentials
# Then run: docker compose run --rm -it --env-file .env.gajaeway setup gajaeway setup

# Discord token (get from https://discord.com/developers/applications)
GAJAEWAY_DISCORD_TOKEN=

# Slack bot token (get from https://api.slack.com/apps)
GAJAEWAY_SLACK_BOT_TOKEN=

# Slack app-level token (starts with xapp-)
GAJAEWAY_SLACK_APP_TOKEN=

# Telegram bot token (get from @BotFather on Telegram)
GAJAEWAY_TELEGRAM_TOKEN=

# Your numeric user/profile ID(s) to allow DMs
# Multiple IDs can be comma-separated: "123456789,987654321"
GAJAEWAY_OWNER_IDS=

# Discord application ID (optional, for verification)
# Get from https://discord.com/developers/applications
# GAJAEWAY_DISCORD_APP_ID=
