# The multi-platform adapter has no durable journal checkpoint locally, but Telegram
# persists its update offset and per-chunk send ledger under the adapter state dir.
# Discord remains the compatibility service/entrypoint; enabled Telegram channels
# run concurrently from the keyed adapter configuration.
[Unit]
Description=Gajaeway Discord adapter

# The root-owned recovery marker below rejects every adapter activation while a
# quarantine is being cleared, including the daemon's Wants= and restart paths.
# The quarantine runbook removes it only after a bound receipt clears the fence.
ConditionPathExists=!/etc/gajaeway/recovery/no-discord-ingress
Requires=gajaeway.service
BindsTo=gajaeway.service
PartOf=gajaeway.service
After=network-online.target gajaeway.service
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=gajaeway
Group=gajaeway
UMask=0077
Environment=HOME=/var/lib/gajaeway
Environment=GAJAEWAY_STATE_DIR=/var/lib/gajaeway
Environment=GAJAEWAY_PROFILE=/etc/gajaeway/profile.toml
# Install /etc/gajaeway/credentials/discord-token as root:root, mode 0600.
# %d is this unit's private credentials directory, not a secret value.
LoadCredential=discord-token:/etc/gajaeway/credentials/discord-token
Environment=GAJAEWAY_DISCORD_TOKEN_FILE=%d/discord-token
ExecStart=/usr/local/bin/gajaeway-discord --state-dir /var/lib/gajaeway --profile /etc/gajaeway/profile.toml
LoadCredential=telegram-token:/etc/gajaeway/credentials/telegram-token
Environment=GAJAEWAY_TELEGRAM_TOKEN_FILE=%d/telegram-token
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
MemoryMax=512M
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The adapter may connect to this UDS but owns no persistent data there.
ReadOnlyPaths=/var/lib/gajaeway

[Install]
WantedBy=multi-user.target
