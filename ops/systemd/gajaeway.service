# Install this unit after creating the dedicated gajaeway system user with a
# home under /var/lib/gajaeway. Replace the corpus and workspace placeholders
# below with the profile's exact writable paths before enabling the service.
[Unit]
Description=Gajaeway operator-agent runtime
# Normal topology restores the adapter after daemon startup/restart: this Wants=
# edge pulls it in; BindsTo= stops it on daemon loss and PartOf= follows restarts.
# Quarantine recovery creates the root-owned no-ingress marker documented in the
# quarantine runbook. The adapter's ConditionPathExists= rejects every start,
# including Wants= and automatic restarts, until clearance removes that marker.
Wants=network-online.target gajaeway-discord.service
After=network-online.target
Before=gajaeway-discord.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
# Startup remains bounded only until the fenced RPC bridge is installed. A busy
# adopted persona receives READY=1 with a verifying STATUS, so per-boot tail
# verification cannot consume this timeout or kill the recoverable gateway.
TimeoutStartSec=6min
User=gajaeway
Group=gajaeway
UMask=0077
WorkingDirectory=/var/lib/gajaeway
Environment=HOME=/var/lib/gajaeway
Environment=GAJAEWAY_STATE_DIR=/var/lib/gajaeway
Environment=GAJAEWAY_PROFILE=/etc/gajaeway/profile.toml
RuntimeDirectory=gajaeway
RuntimeDirectoryMode=0700
StateDirectory=gajaeway
StateDirectoryMode=0700
ExecStart=/usr/local/bin/gajaeway serve --state-dir /var/lib/gajaeway --profile /etc/gajaeway/profile.toml
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=78
TimeoutStopSec=30s
KillMode=mixed
MemoryMax=1G
TasksMax=256
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Keep ProtectHome=true when corpus and workspace live outside /home. If either
# must live below /home, set ProtectHome=read-only and add its exact path to
# ReadWritePaths; never disable this sandbox broadly.
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# /var/lib/gajaeway is StateDirectory. The latter two paths are deployment
# placeholders and must match [corpus] path/workspace in the installed profile.
ReadWritePaths=/var/lib/gajaeway /srv/gajaeway/corpus /srv/gajaeway/workspace

[Install]
WantedBy=multi-user.target