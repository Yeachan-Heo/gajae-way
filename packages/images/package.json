{
	"name": "@gajae-gateway/images",
	"version": "0.1.0",
	"type": "module",
	"description": "Bounded image validation, downloading, and prompt-image preparation for gajaeway clients.",
	"license": "AGPL-3.0-only",
	"author": "Yeachan Heo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Yeachan-Heo/gajae-way.git",
		"directory": "packages/images"
	},
	"homepage": "https://github.com/Yeachan-Heo/gajae-way/tree/main/packages/images#readme",
	"bugs": "https://github.com/Yeachan-Heo/gajae-way/issues",
	"keywords": [
		"gajaeway",
		"images",
		"image-processing",
		"gateway"
	],
	"files": [
		"dist",
		"src"
	],
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --format esm --external @gajae-gateway/protocol --external image-size --external jimp && tsc -p tsconfig.build.json",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@gajae-gateway/protocol": "workspace:*",
		"image-size": "2.1.0",
		"jimp": "1.6.1"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
